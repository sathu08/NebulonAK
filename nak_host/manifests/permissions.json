    "performance_evaluator": {
      "description": "Impartial assessor: validates expectations, gathers trace evidence and scores with explicit rules. Read-only by default; report writes require a per-worker override.",
      "tools": {
        "assertion": "allow",
        "trace": "allow",
        "scorecard": "allow",
        "report": "deny"
      },
      "capabilities": {
        "assertion.check": "allow",
        "trace.read": "allow",
        "scorecard.score": "allow",
        "report.write": "deny"
