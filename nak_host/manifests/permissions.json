    },
    "developer": {
      "description": "Builds and fixes code opencode-style: reads, plans, implements via file writes and terminal checks. Writes gated by approval; no deletes.",
      "tools": {
        "file": "allow",
        "directory": "allow",
        "terminal": "allow",
        "observe": "allow",
