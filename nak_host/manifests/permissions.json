{
  "version": "1.0.0",
  "_comment": "Worker <-> harness access boundary. Which worker (agent) may use which tools. Enforced by ToolEngine.inspect() BEFORE any tool runs: verdicts are allow (run), ask (needs approver, else denied with need_approval:true), deny (blocked). Fail-closed: unknown worker/tool, missing entry, disabled worker and errors all deny (see defaults). workers.json identities stay human-readable; THIS file is the executable boundary.",
  "defaults": {
    "unknown_worker": "deny",
    "unknown_tool": "deny",
    "missing_permission": "deny",
    "error": "deny"
  },
  "roles": {
    "project_manager": {
      "description": "Manages projects, priorities, deadlines, risks and coordination.",
      "tools": {
        "file": "allow",
        "directory": "allow",
        "terminal": "allow",
        "observe": "allow",
        "search": "allow"
      },
      "capabilities": {
        "file.read": "allow",
        "file.list": "allow",
        "file.write": "ask",
        "file.delete": "deny",
        "directory.list": "allow",
        "directory.write": "ask",
        "directory.delete": "deny",
        "terminal.exec": "allow",
        "observe.read": "allow",
        "search.read": "allow"
      },
      "resources": {
        "files": {
          "read": [
            "./workspace/**",
            "./project/**",
            "./docs/**",
            "./test/**"
          ],
          "write": [
            "./workspace/**",
            "./output/**",
            "./test/**"
          ],
          "deny": [
            "**/.env",
            "**/.git/**",
            "**/.ssh/**",
            "**/*password*",
            "**/*secret*",
            "**/*credential*"
          ]
        }
      }
    },
    "researcher": {
      "description": "Plans only: reads and lists files to ground research plans. No writes, no deletes, no terminal, no control actions.",
      "tools": {
        "file": "allow",
        "directory": "allow",
        "terminal": "deny",
        "observe": "allow",
        "search": "allow"
